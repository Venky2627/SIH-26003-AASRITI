# ==============================================================================
# SMRITISETU (SIH26003) - FASTAPI BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to backend/.env for local cloud development.
# ==============================================================================

# Server Environment
APP_ENV=development
APP_DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smritisetu_user
POSTGRES_PASSWORD=smritisetu_secure_pass_2025
POSTGRES_DB=smritisetu_db
DATABASE_URL=postgresql+asyncpg://smritisetu_user:smritisetu_secure_pass_2025@localhost:5432/smritisetu_db

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Security & JWT Credentials (DPDA 2023 Compliance)
# Generate a new 256-bit secret via: openssl rand -hex 32
JWT_SECRET_KEY=4a8b79f982d61a3294c7b8e104938102948b7c6d5e4f3a2b1c0d9e8f7a6b5c4d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Include local mobile IP addresses and development ports)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:8000","http://10.0.2.2:8000"]

# Sync Ingestion Constraints
MAX_BATCH_SIZE=50
SYNC_TIMEOUT_SECONDS=15
