rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User profile collection (Caregivers, Doctors, ASHA workers)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Patient profiles - accessible by linked caregivers, ASHA workers, and approved doctors
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      
      // Patient relationships (Family Trivia & Memory Album)
      match /relationships/{relId} {
        allow read, write: if isAuthenticated();
      }
      
      // Game sessions telemetry
      match /game_sessions/{sessionId} {
        allow read, write: if isAuthenticated();
      }
      
      // Caregiver and ASHA observation logs
      match /care_logs/{logId} {
        allow read, write: if isAuthenticated();
      }
      
      // Offline reminders
      match /reminders/{reminderId} {
        allow read, write: if isAuthenticated();
      }
      
      // Doctor access approvals
      match /doctor_access/{accessId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // Sync queue collection for server-side processing
    match /sync_queue/{queueId} {
      allow read, write: if isAuthenticated();
    }
  }
}
