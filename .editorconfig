# ==============================================================================
# SMRITISETU (SIH26003) - MASTER EDITORCONFIG
# Enforces uniform indentation, character encoding, and line endings across all 6 IDEs
# ==============================================================================

root = true

# All files default settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JavaScript, TypeScript, JSX, TSX (Mobile App)
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# JSON and Configuration files
[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
max_line_length = 120

# Python Backend and AI/ML scripts
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# SQL and SQLite Migration scripts
[*.sql]
indent_style = space
indent_size = 2

# Shell and Bash automation scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

# Dockerfiles and Compose files
[Dockerfile*]
indent_style = space
indent_size = 2

[docker-compose*.yml]
indent_style = space
indent_size = 2
