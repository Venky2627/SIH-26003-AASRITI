{
  "expo": {
    "name": "SmritiSetu",
    "slug": "smritisetu-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.doner.sih26003.smritisetu",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SmritiSetu uses your microphone locally on device to evaluate speech recall in Story Weaver and Picture Naming games. Raw audio is processed strictly in volatile RAM and is never stored or uploaded."
      }
    },
    "android": {
      "package": "gov.doner.sih26003.smritisetu",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "SmritiSetu uses your microphone locally on device to evaluate speech recall in Story Weaver and Picture Naming games. Raw audio is processed strictly in volatile RAM and is never stored or uploaded."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "sih26003-smritisetu"
      }
    }
  }
}
