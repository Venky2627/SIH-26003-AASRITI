# ==============================================================================
# SMRITISETU (SIH26003) - MOBILE CLIENT ENVIRONMENT CONFIGURATION
# Copy this file to mobile-app/.env for local development.
# Do NOT commit actual .env file containing production secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Application Release Metadata
EXPO_PUBLIC_APP_NAME="SmritiSetu"
EXPO_PUBLIC_APP_VERSION="1.0.0"
EXPO_PUBLIC_APP_BUILD_NUMBER=1

# Local Database & Encryption Configuration
# 64-character hexadecimal test key for SQLCipher development (Randomized in production via Keystore)
EXPO_PUBLIC_SQLCIPHER_DEV_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
EXPO_PUBLIC_DATABASE_NAME=patient_records.db

# Edge AI & ONNX Runtime Configuration
EXPO_PUBLIC_ONNX_EXECUTION_PROVIDER=NNAPI
EXPO_PUBLIC_ONNX_INT8_MODEL_PATH=assets/models/indic_conformer_int8.onnx
EXPO_PUBLIC_ASR_DEFAULT_LANGUAGE=as
EXPO_PUBLIC_ASR_CONFIDENCE_THRESHOLD=0.65

# Offline Synchronization Configuration (Cloud Gateway Endpoint)
# In local development with physical Android device, use your machine's LAN IP (e.g., http://192.168.1.50:8000)
# In emulator, use http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_SYNC_BATCH_SIZE=25
EXPO_PUBLIC_SYNC_INTERVAL_MS=30000
EXPO_PUBLIC_MAX_SYNC_RETRY_COUNT=5

# Accessibility & Clinical Game Tuning
EXPO_PUBLIC_DEFAULT_CONTRAST_RATIO=AAA
EXPO_PUBLIC_TREMOR_DEBOUNCE_MS=600
EXPO_PUBLIC_MIN_TOUCH_DWELL_MS=80
