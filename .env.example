# ==============================================================================
# AASRITI (SIH-26003) — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY RULE:
# NEVER commit .env, private keys, API secrets, or passwords to Git.
# .env is permanently ignored by .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME MODE
# ------------------------------------------------------------------------------
# OFFLINE_MODE: When true, enforces 100% offline Room SQLite operation (Default: true)
AASRITI_OFFLINE_MODE=true

# ENVIRONMENT: 'development', 'staging', or 'production'
AASRITI_ENV=development

# DEBUG_LOGGING: Set to false in production to prevent logging PII/clinical events
AASRITI_DEBUG_LOGGING=true

# ------------------------------------------------------------------------------
# 2. FIREBASE / SECONDARY CLOUD REPLICATION (OPTIONAL)
# ------------------------------------------------------------------------------
# AASRITI operates 100% autonomously offline without Firebase.
# These variables are only required if testing background opportunistic sync.
FIREBASE_PROJECT_ID=sih26003-smritisetu-dev
FIREBASE_APPLICATION_ID=1:000000000000:android:0000000000000000000000
FIREBASE_API_KEY=AIzaSyFakeKeyForDevelopmentTemplateOnly00
FIREBASE_STORAGE_BUCKET=sih26003-smritisetu-dev.appspot.com

# ------------------------------------------------------------------------------
# 3. LOCAL ENCRYPTION & SECURITY (CRYPTO)
# ------------------------------------------------------------------------------
# SQLCipher database passkey salt (in production, dynamically generated via Android KeyStore)
AASRITI_LOCAL_KEY_SALT=LocalDevSaltDoNotUseInProduction32BytesLong

# ------------------------------------------------------------------------------
# 4. ANDROID KEYSTORE / RELEASE SIGNING (PRODUCTION CI ONLY)
# ------------------------------------------------------------------------------
# In CI, these are supplied via GitHub Repository Secrets. Never fill locally!
KEYSTORE_FILE=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
