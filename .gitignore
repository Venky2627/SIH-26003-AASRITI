# ==============================================================================
# SMRITISETU (SIH26003) - MASTER .GITIGNORE
# Comprehensive Ignore Rules for Native Android, Kotlin, Gradle, Edge ML, and OS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS, CREDENTIALS, AND SENSITIVE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
*.env
*.env.*
*.keystore
*.jks
*.p12
*.p8
*.key
id_rsa
id_rsa.pub
*.pem
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 2. AUDIO RECORDINGS & PATIENT BIOMETRIC DATA (DPDA 2023 PRIVACY)
# ------------------------------------------------------------------------------
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
*.pcm
**/audio_temp/
**/recordings/
**/patient_cache/

# ------------------------------------------------------------------------------
# 3. LARGE BINARY MACHINE LEARNING MODELS & WEIGHTS (> 50MB)
# ------------------------------------------------------------------------------
*.onnx
*.pt
*.pth
*.bin
*.tflite
*.safetensors
*.ckpt
**/model_checkpoints/
**/weights/

# ------------------------------------------------------------------------------
# 4. LOCAL DATABASES & PERSISTENCE ARTIFACTS
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.sql
*.dump

# ------------------------------------------------------------------------------
# 5. ANDROID NATIVE & GRADLE BUILD ARTIFACTS
# ------------------------------------------------------------------------------
.gradle/
build/
app/build/
**/build/
.cxx/
captures/
local.properties
*.iml
app/*.iml
*.apk
*.aab
*.ap_

# ------------------------------------------------------------------------------
# 6. PYTHON TOOLING & SCRIPTS (SCIKIT-LEARN MODEL TRAINING)
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 7. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory

# ------------------------------------------------------------------------------
# 8. IDE & CODE EDITOR WORKSPACES
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iws
*.orig
*.rej
*.swp
*.swo
