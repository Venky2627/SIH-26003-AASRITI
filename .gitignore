# ==============================================================================
# SMRITISETU (SIH26003) - MASTER .GITIGNORE
# Comprehensive Ignore Rules for React Native, Node, Python, Edge ML, and OS
# Every entry is commented explaining why it must not be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS, CREDENTIALS, AND SENSITIVE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# Environment variables containing private keys, DB passwords, and signing secrets
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
# Android signing keystores - leaks compromise app integrity in Google Play / sideloading
*.keystore
*.jks
# iOS security certificates and provisioning profiles
*.p12
*.p8
*.mobileprovision
*.key
# Generic private and public key pairs
id_rsa
id_rsa.pub
*.pem
# Cloud service account credentials
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 2. AUDIO RECORDINGS & PATIENT BIOMETRIC DATA (DPDA 2023 PRIVACY REQUIREMENT)
# ------------------------------------------------------------------------------
# Audio must NEVER be committed to version control; raw patient speech is private medical data
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
*.pcm
# Audio caching and temp recording directories created by expo-av or native audio recorders
**/audio_temp/
**/recordings/
**/patient_cache/

# ------------------------------------------------------------------------------
# 3. LARGE BINARY MACHINE LEARNING MODELS & WEIGHTS (> 50MB)
# ------------------------------------------------------------------------------
# Pre-trained and quantized ONNX/PyTorch models should be fetched via DVC or release assets
*.onnx
*.pt
*.pth
*.bin
*.tflite
*.safetensors
*.ckpt
# Model checkpoint directories and training checkpoints
**/model_checkpoints/
**/weights/
# Exception: Keep dummy lightweight model stub for offline integration test suites
!mobile-app/src/assets/models/indic_conformer_stub.onnx.gitkeep

# ------------------------------------------------------------------------------
# 4. LOCAL DATABASES & PERSISTENCE STORAGE ARTIFACTS
# ------------------------------------------------------------------------------
# SQLite database files created during local testing and development
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
# SQLCipher key caches and ephemeral DB dumps
*.sql
*.dump

# ------------------------------------------------------------------------------
# 5. NODE.JS & REACT NATIVE (EXPO) DEPENDENCIES & BUILD ARTIFACTS
# ------------------------------------------------------------------------------
# Node package dependencies - thousands of files, must be installed via `npm install`
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Expo build artifacts and local cache
.expo/
.expo-shared/
web-build/
dist/

# Metro bundler cache directory
.metro-health-check*

# Fastlane iOS/Android deployment automation outputs
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots

# Bundle outputs generated by React Native CLI
*.jsbundle
*.bundle

# ------------------------------------------------------------------------------
# 6. ANDROID NATIVE BUILD ARTIFACTS
# ------------------------------------------------------------------------------
# Android Studio project structure and native compiler outputs
mobile-app/android/.gradle/
mobile-app/android/build/
mobile-app/android/app/build/
mobile-app/android/.cxx/
mobile-app/android/captures/
mobile-app/android/local.properties
mobile-app/android/*.iml
mobile-app/android/app/*.iml

# Generated APKs, AABs, and debug logs
*.apk
*.aab
*.ap_

# ------------------------------------------------------------------------------
# 7. IOS NATIVE BUILD ARTIFACTS
# ------------------------------------------------------------------------------
# Xcode project artifacts and CocoaPods dependencies
mobile-app/ios/Pods/
mobile-app/ios/build/
mobile-app/ios/*.xcworkspace
mobile-app/ios/*.xcodeproj/xcuserdata/
mobile-app/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
mobile-app/ios/DerivedData/

# ------------------------------------------------------------------------------
# 8. PYTHON BACKEND & ML TOOLING (FASTAPI / PYTORCH / ALEMBIC)
# ------------------------------------------------------------------------------
# Python virtual environments
backend/.venv/
backend/venv/
backend/env/
.venv/
venv/
env/
ENV/

# Python compiled bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Pytest and code coverage reporting artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Mypy and Ruff static type checking and linting caches
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 9. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
# macOS folder metadata and desktop services store
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows directory layout configuration and thumbnail databases
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux temporary and backup files
*~
.directory

# ------------------------------------------------------------------------------
# 10. IDE & CODE EDITOR WORKSPACES
# ------------------------------------------------------------------------------
# Visual Studio Code local settings (except recommended extensions & settings if standardized)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains IntelliJ / WebStorm / PyCharm workspace files
.idea/
*.iws
*.iml

# Patch and temporary merge artifacts
*.orig
*.rej
*.swp
*.swo
*~
